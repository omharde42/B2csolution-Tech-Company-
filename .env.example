# =============================================================================
# B2CSolution — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Supabase (required for website) ─────────────────────────────────────────
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# ─── Supabase Edge Function Secrets ──────────────────────────────────────────
# Set these in Supabase Dashboard → Edge Functions → Secrets
# (Do NOT put them in this .env file — they are server-side only)
#
# TELEGRAM_BOT_TOKEN=        # From @BotFather on Telegram
# TELEGRAM_WEBHOOK_SECRET=   # Random string for webhook validation
# GEMINI_API_KEY=            # From Google AI Studio (aistudio.google.com)
# ADMIN_TELEGRAM_CHAT_ID=    # Your Telegram user ID (from @userinfobot)
# LOVABLE_API_KEY=           # Lovable AI Gateway key (for web chatbot)
#
# These are AUTO-INJECTED by Supabase (do not set manually):
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_ANON_KEY
